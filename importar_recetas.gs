function obtenerOCrearSpreadsheet() {
  const nombre = 'Registro Facturas - Malagana Rooftop';
  const existentes = DriveApp.getFilesByName(nombre);
  if (existentes.hasNext()) return SpreadsheetApp.openById(existentes.next().getId());
  return SpreadsheetApp.create(nombre);
}
